# Copy to .env and fill in. docker compose reads .env; `npm run dev` reads .env.local.

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# MongoDB. Leave unset with docker compose to use the bundled mongo container.
# MONGODB_URI=mongodb+srv://...

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# UploadThing (photo uploads)
UPLOADTHING_TOKEN=...

# Resend (optional, emails are skipped if unset)
RESEND_API_KEY=

# Comma-separated Clerk user IDs allowed into /admin
ADMIN_CLERK_IDS=

# Public URL of the app, used for Stripe redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
